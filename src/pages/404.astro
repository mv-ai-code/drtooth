---
import BaseLayout from '../layouts/BaseLayout.astro';
import { offices, tel } from '../data/site';
---

<BaseLayout title="Page not found" noindex>
  <section class="container-page max-w-2xl py-20 text-center sm:py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 text-5xl text-navy-dark">We couldn't find that page</h1>
    <p class="mt-4 text-lg text-ink-muted">The page may have moved. Try the home page, or call us.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      {
        offices.map((o) => (
          <a href={tel(o.phone)} class="btn btn-secondary">
            {o.city} {o.phone}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
