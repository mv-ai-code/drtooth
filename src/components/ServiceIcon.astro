const icons: Record<string, string[]> = {
  filling: [tooth, 'M10 8.5a2 2 0 1 0 4 0 2 2 0 0 0-4 0z'],
  rootcanal: [tooth, 'M10 9.5v6 M14 9.5v6'],
  extraction: [
    'M8 7C5.6 7 4.2 8.7 4.2 11c0 2 .9 3.3 1.3 5.2.5 2.2.9 4.8 2.3 4.8 1.3 0 1.6-3 3.9-3s2.6 3 3.9 3c1.4 0 1.8-2.6 2.3-4.8.4-1.9 1.3-3.2 1.3-5.2C19.4 8.7 18 7 15.6 7c-1.4 0-2.2.6-3.6.6S9.4 7 8 7z',
    'M12 1v3.5 M9.8 3 12 1l2.2 2',
  ],
  implant: [
    'M6.5 3.5h11c0 3-1.5 5-5.5 5s-5.5-2-5.5-5z',
    'M9 11h6 M9.5 14h5 M10 17h4 M10.7 20h2.6 M12 8.5v13',
  ],
  bonegraft: [tooth, 'M3 21.5h18 M5 18.5h2 M17 18.5h2'],
  // Three joined crowns: roots under the two anchor teeth, none under the middle one.
  bridge: [
    'M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5v3H3z',
    'M9 5v5.5 M15 5v5.5',
    'M3.8 10.5c.4 3.2.9 8 2.2 8s1.8-4.8 2.2-8 M15.8 10.5c.4 3.2.9 8 2.2 8s1.8-4.8 2.2-8',
    'M9.5 10.5c0 1.6 1.1 2.6 2.5 2.6s2.5-1 2.5-2.6',
  ],
  dentures: [
    'M3 9.5c0-2 1.2-3.5 3.2-3.5 1 0 1.6.4 2.3.4S9.8 6 10.8 6C12.8 6 14 7.5 14 9.5c0 1.7-.7 2.7-1 4.3-.4 1.9-.7 4.7-1.9 4.7-1.1 0-1.3-2.9-2.6-2.9S7 18.5 5.9 18.5c-1.2 0-1.5-2.8-1.9-4.7-.3-1.6-1-2.6-1-4.3z',
    'M14 9.5c0-2 1.2-3.5 3.2-3.5 1.1 0 1.6.4 1.8.4 M21 9.5c0 1.7-.7 2.7-1 4.3-.4 1.9-.7 4.7-1.9 4.7',
  ],
  crown: [tooth, 'M5 6.5l2.5 2 2-3 2.5 3 2.5-3 2 3 2.5-2'],
  cerec: [tooth, 'M13 7l-3 4.5h4L11 16'],
  cbct: ['M12 2.5 20.5 7v10L12 21.5 3.5 17V7z', 'M3.5 7 12 11.5 20.5 7 M12 11.5v10'],
  botox: ['M18 2.5 21.5 6 M19.7 4.3l-3.2 3.2 M16.5 4 20 7.5', 'M17.5 6.5 8 16l-2.5-.5L5 13l9.5-9.5z', 'M8.5 12.5l1.5 1.5 M11 10l1.5 1.5 M5.5 15.5 2.5 21.5'],
  lips: [
    'M2.5 11.5C4.5 8 7.2 6 9.2 6c1.3 0 2 .8 2.8.8s1.5-.8 2.8-.8c2 0 4.7 2 6.7 5.5',
    'M2.5 11.5c2 3.8 5.4 6 9.5 6s7.5-2.2 9.5-6c-3 .7-6 1-9.5 1s-6.5-.3-9.5-1z',
  ],
};

interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'size-7' } = Astro.props;
const d = icons[name] ?? [tooth];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {d.map((p) => <path d={p} />)}
</svg>
