---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Icon from './Icon.astro';
import { offices, tel } from '../data/site';

const nav = [
  { label: 'Services', href: '/#services' },
  { label: 'About', href: '/#about' },
  { label: 'Locations', href: '/#locations' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/85">
  <!-- Call bar: both offices, tappable -->
  <div class="bg-navy-dark text-white">
    <div class="container-page flex flex-wrap items-center justify-center gap-x-6 gap-y-1 py-1.5 text-sm sm:justify-end">
      {
        offices.map((o) => (
          <a href={tel(o.phone)} class="inline-flex items-center gap-1.5 hover:underline">
            <Icon name="phone" class="size-3.5 opacity-80" />
            <span class="opacity-80">{o.city}</span>
            <span class="font-semibold tabular-nums">{o.phone}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href="/" class="shrink-0" aria-label="Dr. Tooth home">
      <Image src={logo} alt="" widths={[150, 300, 450]} sizes="150px" class="h-[3.25rem] w-auto sm:h-[4.25rem]" loading="eager" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
      {
        nav.map((n) => (
          <a href={n.href} class="font-medium text-navy-dark/80 transition-colors hover:text-navy">
            {n.label}
          </a>
        ))
      }
      <a href="/#appointment" class="btn btn-primary !py-2.5">
        <Icon name="calendar" class="size-4" />
        Request appointment
      </a>
    </nav>

    <button
      type="button"
      class="-mr-2 inline-flex size-11 items-center justify-center rounded-lg md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <Icon name="menu" class="size-6" />
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Main" class="hidden border-t border-line bg-cream md:hidden" data-menu>
    <ul class="container-page flex flex-col py-2">
      {
        nav.map((n) => (
          <li>
            <a href={n.href} class="block py-3 text-lg font-medium">
              {n.label}
            </a>
          </li>
        ))
      }
      <li class="py-3">
        <a href="/#appointment" class="btn btn-primary w-full">Request appointment</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
  }
</script>
