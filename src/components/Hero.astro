---
/**
 * Home page hero. To swap the photo, replace src/assets/hero.jpg (this is its only reference)
 * and update `alt` below.
 */
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
import Icon from './Icon.astro';
import { site, stats } from '../data/site';
---

<section class="relative overflow-hidden">
  <div class="container-page grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:py-20">
    <div>
      <p class="eyebrow">{site.dentist}</p>
      <h1 class="mt-3 text-5xl leading-[1.05] text-navy-dark sm:text-6xl lg:text-7xl">
        Family &amp; Implant <span class="text-orange-strong">Dentistry</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">
        Exceptional dental and cosmetic care in Bellevue and Mountlake Terrace. From routine checkups to dental implants and
        aesthetic treatments, we're here to help you achieve a healthy, beautiful smile.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#appointment" class="btn btn-primary">
          <Icon name="calendar" class="size-4" />
          Request appointment
        </a>
        <a href="#services" class="btn btn-secondary">View our services</a>
      </div>

      <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4 border-t border-line pt-6">
        {
          stats.map((s) => (
            <div class="flex flex-col-reverse">
              <dt class="text-sm text-ink-muted">{s.label}</dt>
              <dd class="font-serif text-4xl font-semibold text-navy-dark">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="relative">
      <div class="absolute -top-4 -right-4 hidden h-40 w-40 rounded-3xl bg-orange-soft lg:block" aria-hidden="true"></div>
      <div class="absolute -bottom-4 -left-4 hidden h-28 w-28 rounded-3xl bg-navy-soft lg:block" aria-hidden="true"></div>
      <Image
        src={heroImage}
        alt="Modern dental treatment room"
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 1024px) 34rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="relative aspect-[4/3] w-full rounded-3xl object-cover shadow-[var(--shadow-card)]"
      />
    </div>
  </div>
</section>
